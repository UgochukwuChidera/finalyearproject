OPENROUTER_API_KEY="your-api-key-here"
# Optional: hard-override the vision model used for extraction (bypasses models.json).
# If not set, the active model is read from models.json (managed via the web UI at /settings).
# Default built-in order: google/gemini-pro-1.5 → openai/gpt-4o-mini → openai/gpt-4o
# OPENROUTER_MODEL="google/gemini-pro-1.5"
